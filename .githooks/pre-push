#!/bin/sh
# Local gate. GitHub Actions CI was removed (Sep 2026) — this is the only
# automated check between a commit and main. Shared implementation:
#   internal/scripts/portfolio-gate.mjs
#   npm run gate
#
# Fail-closed: missing node_modules or python3 refuses the push.
# Bypass (feature branch only): SKIP_PORTFOLIO_GATE=EMERGENCY git push
# A push that updates refs/heads/main cannot bypass — use a PR.
# Installed by `npm run prepare` (core.hooksPath = .githooks).
set -e

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found — install Node.js, then npm install && npm run gate." >&2
  exit 1
fi

exec node internal/scripts/portfolio-gate.mjs --hook
