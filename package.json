{
  "name": "interactive-litigation-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "vite build",
    "check:deadlines": "node internal/scripts/check-deadlines.mjs",
    "citations:check": "python3 internal/scripts/verify-citations.py --check",
    "citations:index": "python3 internal/scripts/build-citation-index.py",
    "citations:index:check": "python3 internal/scripts/build-citation-index.py --check",
    "citations:lookup": "python3 internal/scripts/lookup-citations.py --batch all",
    "citations:lookup:matter": "python3 internal/scripts/lookup-citations.py",
    "citations:lookup:matter28": "python3 internal/scripts/lookup-citations.py --matter 28",
    "citations:queue": "python3 internal/scripts/verify-citations.py --queue",
    "citations:verify": "python3 internal/scripts/verify-citations.py",
    "court:reconcile": "node internal/scripts/courtlistener/reconcile-timeline.mjs",
    "court:resolve": "node internal/scripts/courtlistener/resolve-dockets.mjs",
    "court:sync": "node internal/scripts/courtlistener/sync-dockets.mjs",
    "dev": "vite",
    "docs:fetch": "node internal/scripts/fetch-doc.mjs",
    "q": "node internal/scripts/q.mjs",
    "documents:pull": "node internal/scripts/documents-store.mjs pull",
    "documents:push": "node internal/scripts/documents-store.mjs push",
    "documents:seed": "node internal/scripts/documents-store.mjs seed",
    "extract:matter1": "node internal/scripts/extract-matter-pdfs.mjs",
    "fuse:board": "node internal/scripts/generate-fuse-board.mjs",
    "generate:readme": "node internal/scripts/generate-readme-tables.mjs",
    "index:build": "python3 internal/scripts/build-document-index.py",
    "index:search": "python3 internal/scripts/search-documents.py",
    "intel:counsel": "node internal/scripts/courtlistener/intel/counsel-dossier.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "next": "node internal/scripts/next-actions.mjs",
    "postinstall": "node internal/scripts/postinstall-sync.mjs",
    "prebuild": "npm run sync:derived",
    "prepare": "node internal/scripts/install-githooks.mjs",
    "preview": "vite preview",
    "retire:upcoming": "node internal/scripts/retire-upcoming.mjs",
    "scaffold:matter": "node internal/scripts/scaffold-matter.mjs",
    "sync:all": "node internal/scripts/sync-all.mjs",
    "sync:derived": "npm run sync:summaries && npm run sync:upcoming && npm run sync:short-links && npm run sync:index",
    "sync:index": "node internal/scripts/sync-machine-index.mjs",
    "matter:split": "node internal/scripts/split-matter.mjs",
    "check:sidecars": "node internal/scripts/check-document-sidecars.mjs",
    "sync:manifest": "node internal/scripts/sync-document-manifest.mjs",
    "sync:registry": "node internal/scripts/sync-document-registry.mjs",
    "sync:short-links": "node internal/scripts/sync-short-links.mjs",
    "sync:summaries": "node internal/scripts/sync-matter-summaries.mjs",
    "sync:upcoming": "node internal/scripts/sync-upcoming.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:golden": "node internal/scripts/test-golden.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && node internal/scripts/sync-document-registry.mjs --check && node internal/scripts/generate-readme-tables.mjs --check && node internal/scripts/sync-machine-index.mjs --check && node internal/scripts/validate-portfolio.mjs && npm run citations:check && npm run test:coverage"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
