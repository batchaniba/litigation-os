{
  "name": "interactive-litigation-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sync:summaries": "node internal/scripts/sync-matter-summaries.mjs",
    "sync:upcoming": "node internal/scripts/sync-upcoming.mjs",
    "generate:readme": "node internal/scripts/generate-readme-tables.mjs",
    "validate": "npm run lint && node internal/scripts/sync-matter-summaries.mjs --check && node internal/scripts/sync-upcoming.mjs --check && node internal/scripts/generate-readme-tables.mjs --check && node internal/scripts/validate-portfolio.mjs && npm run test:coverage",
    "scaffold:matter": "node internal/scripts/scaffold-matter.mjs",
    "prebuild": "npm run sync:summaries && npm run sync:upcoming",
    "index:build": "python3 internal/scripts/build-document-index.py",
    "index:search": "python3 internal/scripts/search-documents.py",
    "extract:matter1": "node internal/scripts/extract-matter-pdfs.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
