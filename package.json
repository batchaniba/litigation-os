{
  "name": "interactive-litigation-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sync:summaries": "node internal/scripts/sync-matter-summaries.mjs",
    "sync:registry": "node internal/scripts/sync-document-registry.mjs",
    "sync:upcoming": "node internal/scripts/sync-upcoming.mjs",
    "generate:readme": "node internal/scripts/generate-readme-tables.mjs",
    "validate": "npm run lint && node internal/scripts/sync-document-registry.mjs --check && node internal/scripts/sync-matter-summaries.mjs --check && node internal/scripts/sync-upcoming.mjs --check && node internal/scripts/generate-readme-tables.mjs --check && node internal/scripts/validate-portfolio.mjs && npm run test:coverage",
    "scaffold:matter": "node internal/scripts/scaffold-matter.mjs",
    "prebuild": "npm run sync:registry && npm run sync:summaries && npm run sync:upcoming",
    "index:build": "python3 internal/scripts/build-document-index.py",
    "index:search": "python3 internal/scripts/search-documents.py",
    "extract:matter1": "node internal/scripts/extract-matter-pdfs.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
