{
  "name": "interactive-litigation-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:summaries": "node internal/scripts/sync-matter-summaries.mjs",
    "generate:readme": "node internal/scripts/generate-readme-tables.mjs",
    "validate": "node internal/scripts/sync-matter-summaries.mjs --check && node internal/scripts/generate-readme-tables.mjs --check && node internal/scripts/validate-portfolio.mjs",
    "scaffold:matter": "node internal/scripts/scaffold-matter.mjs",
    "prebuild": "npm run sync:summaries",
    "index:build": "python3 internal/scripts/build-document-index.py",
    "index:search": "python3 internal/scripts/search-documents.py",
    "extract:matter1": "node internal/scripts/extract-matter-pdfs.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
