# Wrangler local secrets (portfolio-gate and other workers).
**/.dev.vars

# Generated at build time (prebuild). Do not commit.
# (vercel.json and internal/public/_redirects, _headers, _routes.json are also
# generated by sync:short-links — but ARE committed: Vercel reads
# git.deploymentEnabled from the repo at push time, and Pages --check needs
# the committed files. Vite copies the public/ files into dist/.)
internal/src/data/matters/summaries.json
internal/src/data/matters/document-index.json
internal/src/data/matters/publish/*.json
internal/src/data/upcoming.json
internal/public/*/index.html

# personal Claude Code overrides (permission grants for private doc store)
.claude/settings.local.json

# D1 seed SQL is generated from canonical repo JSON at reseed time.
# Do not commit snapshots: they can drift behind clocks.json / the manifest.
/seed.sql
/workers/doc-api/seed.sql
/workers/doc-api/seed-chunk-*.sql

# Resumable local document-store recovery checkpoints.
/.document-recovery/

