#!/bin/sh
# If a commit stages matter / timeline / document / short-link sources,
# refresh the derived snapshots and stage them so summaries.json cannot
# lag the records (the #627 failure mode).
set -e
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged="$(git diff --cached --name-only --diff-filter=ACMR || true)"
[ -z "$staged" ] && exit 0

needs_sync=0
printf '%s\n' "$staged" | grep -Eq \
  '^(internal/src/data/timeline\.json|internal/src/data/matters/[0-9]{2}\.json|internal/src/data/damages\.js|internal/src/data/lawyerFees\.js|internal/public/documents/|internal/public/short-links\.json|internal/src/data/documents/registry\.json)' \
  && needs_sync=1

[ "$needs_sync" -eq 0 ] && exit 0

echo "pre-commit: source records staged — running npm run sync:all"
npm run sync:all

git add -- \
  internal/src/data/upcoming.json \
  internal/src/data/matters/summaries.json \
  internal/src/data/matters/document-index.json \
  internal/src/data/documents/registry.json \
  internal/public/short-links.json \
  vercel.json \
  README.md \
  2>/dev/null || true

# Short-link landings are generated under internal/public/<slug>/
# and may be new in this commit.
git add -- internal/public/*/index.html 2>/dev/null || true
